# FuturERP MCP (remote HTTP + OAuth) — server-side env. End users don't need this file:
# they log in with their FuturERP account. Only the deployment (Railway) or a local run needs it.

# Supabase project (pronto-resolver-61)
SUPABASE_URL=https://rczhnuurvcxtkfussmfj.supabase.co

# Data reads (bypass RLS, full org read — unchanged from v1). New-style sb_secret_* preferred,
# legacy service_role JWT accepted. Dashboard → Project Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable/anon key — only used as `apikey` when validating user access tokens (/auth/v1/user).
SUPABASE_PUBLISHABLE_KEY=

# Public URL of this endpoint (used in RFC 9728 protected-resource metadata + WWW-Authenticate).
MCP_PUBLIC_URL=https://mcp.futurenergy.mx/mcp

# Listen port (Railway injects PORT automatically)
PORT=3000
